class cypher_manager
{
string[] letters;
string base_letters = "a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z";
cypher_manager()
{
this.letters = base_letters.split(",");
}
private string insure_letter(string value)
{
return value[0];
}
private int insure_index(int index)
{
if(index< letters.length())
{
return index;
}
int base = 25;
if(index>0)
{
int offset = index-base;
return offset;
}
if(index<0)
{
int offset = abs(index);
return offset;
}
return index;
}
private int get_letter_pos(string letter)
{
string value = insure_letter(value);
return letters.find(value);
}
private string create_key(string key)
{
string final_key = key;
for(int i = 0; i<key.length(); i++)
{
string part = key[i];
if(part.is_digits())
{
int num = parse_int(part);
if(num>26)
{
continue;
}
final_key.replace(part,get_letter_pos(num));
}
}

return final_key;
}
private string shift_right(string letter,int amount)
{
string value = insure_letter(value);
int index = letters.find(value);
int new_index = index+amount;
return get_letter_pos(insure_index(new_index));
}
private string shift_left(string letter, int amount)
{
string value = insure_letter(letter);
int index = letters.find(value);
int new_index = index-amount;
return get_letter_pos(insure_index(new_index));
}

}