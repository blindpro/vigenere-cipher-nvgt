class cypher_manager
{
string[] letters;
string base_letters = "a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z";
cypher_manager()
{
this.letters = base_letters.split(",");
}
private string insure_letter(string value)
{
return value[0];
}
private int insure_index(int index)
{
if(index>0 and index< letters.length())
{
return index;
}
if(index>0)
{
return index%26;
}
if(index<0)
{
int num = abs(index);
int diff = 26-num;
return diff%26;
}
return index;
}
private int get_letter_pos(string letter)
{
string value = insure_letter(letter);
return letters.find(value);
}
private string get_final_key(string key)
{
string final_key = key;
for(int i = 0; i<key.length(); i++)
{
string part = key[i];
if(part.is_digits())
{
int num = parse_int(part);
if(num>26)
{
continue;
}
final_key.replace(part,letters[get_letter_pos(num)]);
}
}

return final_key;
}
private string get_key_value(string key, int passes)
{
if(passes < key.length())
{
return key[passes];
}
else
{
return key[passes%key.length()];
}
}
private int calculate_shift(string shift_letter)
{
int index = get_letter_pos(shift_letter);
return index;
}
private string shift_right(string letter,int amount)
{
string value = insure_letter(letter);
int index = letters.find(value);
int new_index = index+amount;
int final_index = insure_index(new_index);
return letters[final_index];
}
private string shift_left(string letter, int amount)
{
string value = insure_letter(letter);
int index = letters.find(value);
int new_index = index-amount;
int final_index = insure_index(new_index);
return letters[final_index];
}

string  encrypt(string message, string key)
{
string encrypted_message;
int passes = 0;
string main_key = get_final_key(key);
for(int i = 0; i<message.length(); i++)
{
string part = message[i];
if(part.is_digits())
{
part = letters[parse_int(part)];
}
string key_letter = get_key_value(main_key,passes);
encrypted_message+shift_right(part,calculate_shift(key_letter));
passes++;
}
return encrypted_message;
}
string decrypt(string message, string key)
{
string decrypted_message;
int passes = 0;
string main_key = get_final_key(key);
for(int i = 0; i<message.length(); i++)
{
string part = message[i];
if(part.is_digits())
{
part = letters[parse_int(part)];
}
string key_letter = get_key_value(main_key,passes);
decrypted_message+shift_left(part,calculate_shift(key_letter));
passes++;
}
return decrypted_message;

}
}